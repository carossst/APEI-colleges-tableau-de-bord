    {
      "jury": "2021",
      "titre": "Mi-parcours encourageant",
      "detail": "Les projets 2021 montrent déjà des effets positifs sur l’autonomie, le travail en groupe et l’engagement des élèves."
    },
    {
      "jury": "2021",
      "titre": "Vie scolaire transformée",
      "detail": "Quand les espaces de permanence sont investis, les élèves peuvent choisir leurs usages et le climat scolaire s’apaise."
    },
    {
      "jury": "2021",
      "titre": "Cadres de travail renouvelés",
